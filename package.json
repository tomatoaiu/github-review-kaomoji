{
  "name": "github-review-kaomoji",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "wxt",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint TSRS_FAST=1 oxlint .",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsrs --fast --noEmit",
    "zip": "wxt zip"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "jsdom": "31.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.20.0"
  },
  "packageManager": "pnpm@12.20.0"
}
